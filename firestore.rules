rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The user index document itself: /users/{uid}
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Private device, settings, character-context and message documents.
      // Every descendant remains isolated to the authenticated UID.
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
